# ============================================================
#  IoT Irrigation Monitoring System — Blynk Bridge Config
#  Copy this file to .env and fill in YOUR values.
#  NEVER commit .env to version control.
# ============================================================

# --- Blynk Cloud ---
BLYNK_SERVER=blynk.cloud
BLYNK_AUTH_TOKEN=YOUR_DEVICE_AUTH_TOKEN_HERE

# --- Serial Port ---
# Windows:
#   Set SERIAL_PORT to the "Python side" of your virtual COM pair.
#   Example: COM6  (if Proteus COMPIM uses COM5 and COM5<->COM6 is paired)
SERIAL_PORT=COM6
BAUD_RATE=9600

# --- Polling ---
# How often (seconds) to poll Blynk for V6/V7/V8 commands.
POLL_INTERVAL=2
